# sports-keiba.com のベースURL (通常は変更不要)
HORSE_DB_BASE_URL=https://sports-keiba.com

# クローラのUser-Agent。連絡先を含めることを推奨
HORSE_DB_USER_AGENT=horse-measure-db-bot/1.0 (+contact: your-email@example.com)

# リクエスト間隔(秒)。サイトへの負荷軽減のため 1.0 以上を推奨
HORSE_DB_REQUEST_INTERVAL=1.5

# HTTPタイムアウト(秒)
HORSE_DB_TIMEOUT=15

# リトライ回数 (5xxエラー・ネットワークエラー時)
HORSE_DB_MAX_RETRIES=3

# HTTPキャッシュの有効期限(秒)。デフォルト7日間
HORSE_DB_CACHE_TTL=604800

# サイト内検索結果を辿る最大ページ数
HORSE_DB_SEARCH_MAX_PAGES=5

# ログレベル (DEBUG/INFO/WARNING/ERROR)
HORSE_DB_LOG_LEVEL=INFO

# 出力先パス (任意で変更可能)
HORSE_DB_SQLITE_PATH=output/horse_measure.db
HORSE_DB_EXCEL_PATH=output/募集馬測尺DB.xlsx
HORSE_DB_CSV_PATH=output/募集馬測尺DB.csv
